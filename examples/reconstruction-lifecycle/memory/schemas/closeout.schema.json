{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "record_type",
    "schema_version",
    "closeout_id",
    "transaction_id",
    "preservation_commit",
    "derived_commit",
    "remote",
    "branch",
    "observed_sha",
    "verified_at",
    "verification_mechanism",
    "affected_record_ids",
    "validation_results",
    "limitations"
  ],
  "properties": {
    "record_type": {
      "const": "closeout"
    },
    "schema_version": {
      "const": 1
    },
    "closeout_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "preservation_commit": {
      "type": "string",
      "minLength": 1
    },
    "derived_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "remote": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "observed_sha": {
      "type": "string",
      "minLength": 1
    },
    "verified_at": {
      "type": "string",
      "minLength": 1
    },
    "verification_mechanism": {
      "const": "git-fetch-and-merge-base"
    },
    "affected_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "uniqueItems": true
    },
    "validation_results": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operation_mode": {
      "enum": [
        "integrated",
        "archive_only"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "operation_mode"
        ],
        "properties": {
          "operation_mode": {
            "const": "archive_only"
          }
        }
      },
      "then": {
        "properties": {
          "derived_commit": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "derived_commit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}

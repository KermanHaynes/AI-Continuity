{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "record_type",
    "schema_version",
    "export_id",
    "provider",
    "environment",
    "native_export_id",
    "source_files",
    "captured_at",
    "capture_completeness",
    "capture_scope",
    "previous_export_ids"
  ],
  "properties": {
    "record_type": {
      "const": "sot_export"
    },
    "schema_version": {
      "const": 1
    },
    "export_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "native_export_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "captured_at": {
      "type": "string",
      "minLength": 1
    },
    "capture_completeness": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ]
    },
    "capture_scope": {
      "type": "string",
      "minLength": 1
    },
    "previous_export_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "uniqueItems": true
    },
    "publication": {
      "type": "object",
      "required": [
        "status",
        "blockers",
        "retained_local_path"
      ],
      "properties": {
        "status": {
          "enum": [
            "eligible_not_verified_remote",
            "local_only"
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "retained_local_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "local_only"
              }
            }
          },
          "then": {
            "properties": {
              "blockers": {
                "minItems": 1
              },
              "retained_local_path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}

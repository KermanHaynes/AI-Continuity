{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "record_type",
    "schema_version",
    "subject_id",
    "canonical_name",
    "aliases",
    "classifications",
    "scope",
    "exclusions",
    "status",
    "related_subject_ids",
    "source_refs",
    "created_at",
    "updated_at",
    "last_evidence_reviewed_at",
    "integration_state",
    "contributions"
  ],
  "properties": {
    "record_type": {
      "const": "knowledge_subject"
    },
    "schema_version": {
      "const": 1
    },
    "subject_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "classifications": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "provisional",
        "active",
        "dormant",
        "archived"
      ]
    },
    "related_subject_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "uniqueItems": true
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sot_id",
          "message_ids"
        ],
        "properties": {
          "sot_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "message_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "last_evidence_reviewed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "integration_state": {
      "enum": [
        "pending",
        "in_progress",
        "complete",
        "blocked",
        "not_applicable"
      ]
    },
    "contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "occurred_at",
          "classification",
          "description",
          "source_refs"
        ],
        "properties": {
          "occurred_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "classification": {
            "enum": [
              "established_user_position",
              "user_proposal",
              "model_suggestion",
              "rejected_or_superseded",
              "supporting_evidence",
              "contradictory_evidence",
              "unresolved_interpretation"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sot_id",
                "message_ids"
              ],
              "properties": {
                "sot_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "message_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

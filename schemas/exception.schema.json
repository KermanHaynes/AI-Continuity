{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "record_type",
    "schema_version",
    "exception_id",
    "classification",
    "detected_at",
    "affected_record_ids",
    "evidence",
    "last_verified_sha",
    "status",
    "recovery_requirements",
    "correcting_commits"
  ],
  "properties": {
    "record_type": {
      "const": "exception"
    },
    "schema_version": {
      "const": 1
    },
    "exception_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "classification": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "not": {
        "const": "verified_complete"
      }
    },
    "detected_at": {
      "type": "string",
      "minLength": 1
    },
    "affected_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "last_verified_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "open",
        "resolved"
      ]
    },
    "recovery_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "correcting_commits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "record_type",
    "schema_version",
    "work_item_id",
    "title",
    "aliases",
    "type",
    "status",
    "status_history",
    "subject_ids",
    "source_refs",
    "relationships",
    "external_parties",
    "actions",
    "dates",
    "events",
    "outcomes",
    "last_external_verification",
    "resumption",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "record_type": {
      "const": "work_item"
    },
    "schema_version": {
      "const": 3
    },
    "work_item_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "active",
        "waiting",
        "blocked",
        "paused",
        "completed",
        "awaiting_outcome",
        "closed"
      ]
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "previous",
          "new",
          "effective_at",
          "reason",
          "source_refs"
        ],
        "properties": {
          "previous": {
            "enum": [
              null,
              "planned",
              "active",
              "waiting",
              "blocked",
              "paused",
              "completed",
              "awaiting_outcome",
              "closed"
            ]
          },
          "new": {
            "enum": [
              "planned",
              "active",
              "waiting",
              "blocked",
              "paused",
              "completed",
              "awaiting_outcome",
              "closed"
            ]
          },
          "effective_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sot_id",
                "message_ids"
              ],
              "properties": {
                "sot_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "message_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "subject_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "uniqueItems": true
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sot_id",
          "message_ids"
        ],
        "properties": {
          "sot_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "message_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "object",
      "required": [
        "parent",
        "children",
        "depends_on",
        "related_to",
        "follows_from"
      ],
      "properties": {
        "parent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "uniqueItems": true
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "uniqueItems": true
        },
        "related_to": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "uniqueItems": true
        },
        "follows_from": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "external_parties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action_id",
          "description",
          "classification",
          "source_refs",
          "state",
          "date_ids"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "established",
              "proposed"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sot_id",
                "message_ids"
              ],
              "properties": {
                "sot_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "message_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            },
            "minItems": 1
          },
          "state": {
            "enum": [
              "outstanding",
              "completed",
              "cancelled",
              "superseded"
            ]
          },
          "date_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "dates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date_id",
          "kind",
          "at",
          "precision",
          "time_zone",
          "state",
          "source_refs",
          "external_verification"
        ],
        "properties": {
          "date_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "kind": {
            "enum": [
              "external_deadline",
              "internal_target",
              "follow_up"
            ]
          },
          "at": {
            "type": [
              "string",
              "null"
            ]
          },
          "precision": {
            "enum": [
              "date",
              "datetime",
              "unknown"
            ]
          },
          "time_zone": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "enum": [
              "active",
              "satisfied",
              "superseded",
              "cancelled"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sot_id",
                "message_ids"
              ],
              "properties": {
                "sot_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "message_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            },
            "minItems": 1
          },
          "external_verification": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "description",
          "at",
          "precision",
          "time_zone",
          "source_refs",
          "state"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": [
              "string",
              "null"
            ]
          },
          "precision": {
            "enum": [
              "date",
              "datetime",
              "unknown"
            ]
          },
          "time_zone": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sot_id",
                "message_ids"
              ],
              "properties": {
                "sot_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "message_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            },
            "minItems": 1
          },
          "state": {
            "enum": [
              "scheduled",
              "occurred",
              "cancelled",
              "unknown"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "outcome_id",
          "description",
          "classification",
          "occurred_at",
          "source_refs"
        ],
        "properties": {
          "outcome_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "partial",
              "final"
            ]
          },
          "occurred_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sot_id",
                "message_ids"
              ],
              "properties": {
                "sot_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "message_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "last_external_verification": {
      "type": [
        "string",
        "null"
      ]
    },
    "resumption": {
      "type": "object",
      "required": [
        "current_position",
        "last_meaningful_development",
        "next_action_ids",
        "unresolved_questions",
        "pending_external_matters",
        "source_refs",
        "last_reviewed_at"
      ],
      "properties": {
        "current_position": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_meaningful_development": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_action_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "uniqueItems": true
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pending_external_matters": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sot_id",
              "message_ids"
            ],
            "properties": {
              "sot_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "message_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "last_reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
